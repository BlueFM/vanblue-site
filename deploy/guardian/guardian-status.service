[Unit]
Description=Write the site guardian status snapshot
Documentation=https://vanblue.online/
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/vanblue/guardian-status.sh
# Only reads /proc, the nginx log and a symlink, and writes one file.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/www/vanblue/guardian
